@{
ViewData["Title"] = "Home Page";
}

<div class="container-fluid">
    <h1 class="text-center mt-5">Saint John Bowling Association Tournament</h1>
    <div class="m-4 d-flex justify-content-center align-items-center flex-column">
        <span class="text-center mb-4">
            <p class="d-inline">Welcome to the Saint John Bowling Association Tournament registration portal. Teams register with four
            players and </p>
            <p class="text-decoration-underline d-inline">must pay a fee to be fully registered.</p>
        </span>
        <a asp-controller="Team" asp-action="Index" class="btn btn-primary me-2">View Teams</a>
    </div>

    <div class="mb-5 container d-flex flex-column justify-content-center align-items-center">
        <p class="fw-bold">Group 8</p>
        <p>Erika, Josh, Sarah</p>
    </div>
</div>

